+/* Scales a row with weights made by pad_weights: every output pixel has
+ * len weights. With n and len constant the loops unroll completely. */
+static fz_forceinline void
+scale_row_to_temp_fixed(unsigned char * FZ_RESTRICT dst, const unsigned char * FZ_RESTRICT src, const int * FZ_RESTRICT contrib, int count, int flip, const int n, const int len)
+{
+	int step = n;
+	int i, j, k;
+
+	if (flip)
+	{
+		dst += (count - 1) * n;
+		step = -n;
+	}
+	for (i = count; i > 0; i--)
+	{
+		const unsigned char *s = &src[n * contrib[0]];
+		int acc[4] = { 128, 128, 128, 128 };
+		for (k = 0; k < len; k++)
+		{
+			int w = contrib[2 + k];
+			for (j = 0; j < n; j++)
+				acc[j] += s[n * k + j] * w;
+		}
+		for (j = 0; j < n; j++)
+			dst[j] = (unsigned char)(acc[j] >> 8);
+		dst += step;
+		contrib += 2 + len;
+	}
+}
+
+static fz_forceinline void
+scale_row_to_temp_padded(unsigned char * FZ_RESTRICT dst, const unsigned char * FZ_RESTRICT src, const fz_weights * FZ_RESTRICT weights, const int n)
+{
+	const int *contrib = &weights->index[weights->index[0]];
+	int count = weights->count;
+	int flip = weights->flip;
+
+	switch (weights->max_len)
+	{
+	case 1: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 1); break;
+	case 2: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 2); break;
+	case 3: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 3); break;
+	case 4: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 4); break;
+	case 5: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 5); break;
+	case 6: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, 6); break;
+	default: scale_row_to_temp_fixed(dst, src, contrib, count, flip, n, weights->max_len); break;
+	}
+}
