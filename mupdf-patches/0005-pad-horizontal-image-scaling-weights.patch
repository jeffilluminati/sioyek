Faster horizontal image scaling on platforms without the ARM assembly (e.g. arm64, x86): pad the
horizontal weights of every output pixel with zero weights to the same length, as is already done
for the vertical weights, so the loops no longer depend on how many source pixels each output pixel
covers (a mispredicted branch per pixel) and unroll for the common lengths. Zero weights don't
change the sums, so the scaled image is unchanged.

diff --git a/source/fitz/draw-scale-simple.c b/source/fitz/draw-scale-simple.c
--- a/source/fitz/draw-scale-simple.c
+++ b/source/fitz/draw-scale-simple.c
@@ -452,6 +452,56 @@ window_fix(int l, int *rp, float window, float centre)
 	return l;
 }
 
+#ifndef ARCH_ARM
+/* Value of new_line (which is only used while the weights are made) once
+ * pad_weights has given every output pixel max_len weights. */
+#define WEIGHTS_PADDED -1
+
+/* Pads the weights of every output pixel with zeros to the length of the
+ * longest (as reorder_weights does for vertical weights, without the
+ * reordering), moving the first source pixel back where the weights would
+ * run past the end of the row. Zero weights don't change the result, and
+ * the loops that scale a row no longer depend on how many source pixels
+ * each output pixel happens to cover. */
+static void
+pad_weights(fz_weights *weights, int src_w)
+{
+	int count = weights->count;
+	int base = weights->index[0];
+	int len_max = 0;
+	int j;
+
+	for (j = 0; j < count; j++)
+		len_max = fz_maxi(len_max, weights->index[weights->index[j] + 1]);
+	if (len_max == 0 || len_max > weights->max_len || len_max > src_w)
+		return;
+
+	/* Each record only grows, so moving them from the last one back never
+	 * overwrites a record that hasn't been moved yet. */
+	for (j = count - 1; j >= 0; j--)
+	{
+		int old = weights->index[j];
+		int min = weights->index[old];
+		int len = weights->index[old + 1];
+		int idx = base + j * (2 + len_max);
+		int off = 0;
+		if (min + len_max > src_w)
+		{
+			off = min + len_max - src_w;
+			min = src_w - len_max;
+		}
+		memmove(&weights->index[idx + 2 + off], &weights->index[old + 2], sizeof(int) * len);
+		memset(&weights->index[idx + 2], 0, sizeof(int) * off);
+		memset(&weights->index[idx + 2 + off + len], 0, sizeof(int) * (len_max - len - off));
+		weights->index[idx] = min;
+		weights->index[idx + 1] = len_max;
+		weights->index[j] = idx;
+	}
+	weights->max_len = len_max;
+	weights->new_line = WEIGHTS_PADDED;
+}
+#endif
