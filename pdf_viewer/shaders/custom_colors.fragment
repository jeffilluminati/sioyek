precision mediump float;

out vec4 color;
in vec2 screen_pos;
in vec2 uvs;

uniform mat4 transform_matrix;
uniform float preserve_faithful;

uniform sampler2D pdf_texture;


void main(){
    vec4 tex = texture(pdf_texture, uvs);
    vec4 pdf_color = vec4(tex.rgb, 1.0);
    vec3 resulting_unclamped_color = (transform_matrix * pdf_color).rgb;
    vec3 recolored = clamp(resulting_unclamped_color, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
    float weight = mix(1.0, tex.a, preserve_faithful);
    color = vec4(mix(tex.rgb, recolored, weight), 1.0);
}
