# Translated from ~/.config/zathura/zathurarc (gruvbox dark).

# default-bg / render-loading-bg
background_color                        #282828
custom_color_mode_empty_background_color #282828

# recolor-lightcolor / recolor-darkcolor (toggled with i or ^r; I swaps faithful images vs totally darkened)
custom_background_color                 #282828
custom_text_color                       #ebdbb2
faithful_images_in_dark_mode            1

# statusbar-bg / statusbar-fg (also used for the command/input bar)
status_bar_color                        #504945
status_bar_text_color                   #ebdbb2

# completion-* / index-* (command palette, file browser, table of contents)
ui_background_color                     #504945
ui_text_color                           #ebdbb2
ui_selected_background_color            #83a598
ui_selected_text_color                  #504945

# highlight-active-color / highlight-color
search_highlight_color                  #fe8019
unselected_search_highlight_color       #fabd2f
text_highlight_color                    #fabd2f

# page-padding 1 (a 1px line in the background color between pages)
page_separator_width                    1
page_separator_color                    #282828

# font 'monospace normal 14'
ui_font                                 Menlo
status_font                             Menlo
font_size                               14
status_bar_font_size                    14

# scroll-step 50 (sioyek moves 72px * amount per step)
vertical_move_amount                    0.69
horizontal_move_amount                  0.69

# map <Button2> scroll half-up / map <Button3> scroll half-down
middle_click_command                    screen_up
right_click_command                     screen_down

# selection-clipboard clipboard
always_copy_selected_text               1

# Optional book folder (root of the o file browser). Set an absolute path for your machine.
# default_open_file_path                /path/to/Books

# Only show the right scrollbar when the cursor moves to its vicinity; maximize window on startup
show_scrollbar_only_when_hovered        1
startup_commands                        maximize

# Standalone first page in dual/multi-page mode by default; toggle auto-page-crop with C
recto_verso_adjustment                  1
auto_crop_pages                         0

# map p print: sioyek has no print command, so hand the file to Preview's print dialog
# Install print.sh as sioyek-print on PATH (macOS only); see README.md.
new_command _print sioyek-print %1
