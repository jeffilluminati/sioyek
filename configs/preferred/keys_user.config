# Zathura-style keybindings for sioyek: zathura(1) defaults plus the custom maps
# from ~/.config/zathura/zathurarc. Bindings here override pdf_viewer/keys.config.
# On macOS <C-x> is the physical Ctrl key and <D-x> is Cmd.
#
# Note: sioyek's move_left/move_right name the direction the *document* moves,
# so zathura's "scroll left" (h) is move_right and "scroll right" (l) is move_left.

# --- Page navigation ---
next_page <pagedown>
previous_page <pageup>

# --- Scrolling (h j k l / arrows) ---
# j/k/<up>/<down> keep sioyek's default move_visual_mark_* which scroll exactly
# like move_down/move_up unless the ruler is active.
move_right h
move_left l
move_right <left>
move_left <right>

# Large pan: H/L move by half the current page's width (about one column when zoomed in)
move_right_half_page H
move_left_half_page L

# Half page: ^t left, ^u up, ^y right  (move_screen_ratio defaults to 0.5)
# (zathurarc remaps ^d to first-page-column, see "Dual page" below)
move_right;move_right;move_right <C-t>
screen_up <C-u>
move_left;move_left;move_left <C-y>

# Full page: t left, ^f/space/d down, ^b/S-space/u up, y right
# Page-aware (like zathura's scroll-page-aware, but never skips the end of a page): moves a
# screen but stops at the edge of the current page, then jumps to align the next page.
goto_left t
screen_down_page_aware <C-f>
screen_down_page_aware <space>
screen_down_page_aware d
screen_up_page_aware <C-b>
screen_up_page_aware <S-<space>>
screen_up_page_aware u
goto_right y

# --- Jumping ---
# zathurarc: map g goto top. G goes to the end; nG (or ng) goes to page n
goto_beginning g
goto_end G
goto_top_of_page P
prev_state <C-o>
next_state <C-i>

# --- Abort ---
escape <C-c>

# --- Fit ---
fit_to_page_height a
fit_to_page_width s

# --- Search ---
search /
search ?
next_item n
previous_item N

# --- Files ---
open_document_embedded o
open_document_embedded_from_current_path O
# Recent files, like vim's CtrlP / fzf.vim history picker (sioyek's default O is used above)
open_prev_doc <C-p>
# Switch back to the previous file, like vim's alternate file (Ctrl+^)
open_last_document <C-^>
reload r
_print p
quit q

# --- Links ---
open_link f
overview_link F
copy_link c

# --- Command line ---
command :

# --- View ---
rotate_clockwise R
toggle_custom_color i
toggle_custom_color <C-r>
goto_toc <tab>
toggle_two_page_mode D
toggle_presentation_mode <f5>
toggle_fullscreen <f11>
toggle_statusbar <C-n>

# --- Dual page ---
# zathurarc: map D toggle_page_mode (above), map <C-d> set "first-page-column 1:2",
# map <C-D> set "first-page-column 1:1". sioyek's recto_verso_adjustment is the same
# thing: 1 puts page 1 alone on the right (book layout), 0 pairs pages from page 1.
setconfig_recto_verso_adjustment(1) <C-d>
setconfig_recto_verso_adjustment(0) <C-D>

# Select a page layout directly: Ctrl+1 is single-page, Ctrl+2..9 select that many columns.
# Repeating a shortcut keeps the selected layout; D toggles the last multi-page layout.
set_pages_per_row(1) <C-1>
set_pages_per_row(2) <C-2>
set_pages_per_row(3) <C-3>
set_pages_per_row(4) <C-4>
set_pages_per_row(5) <C-5>
set_pages_per_row(6) <C-6>
set_pages_per_row(7) <C-7>
set_pages_per_row(8) <C-8>
set_pages_per_row(9) <C-9>

# --- Zoom ---
# sioyek has no "zoom to 100%" command; = and z0 fit to width instead.
zoom_in K
zoom_out J
zoom_in +
zoom_out -
fit_to_page_width =
zoom_in zI
zoom_out zO
fit_to_page_width z0

# --- Quickmarks: mX sets, 'X jumps ---
set_mark m
goto_mark '

# --- macOS: keep Cmd+C for copy since zathura's ^c is abort ---
copy <D-c>
